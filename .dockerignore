dist
**/dist
.next
**/.next

# Turbo cache
.turbo
**/.turbo

# Git metadata
.git
.gitignore

# Local env files (never bake secrets into images)
.env
.env.docker
*.local

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode
.idea

# Test artifacts
coverage
**/coverage
e2e/test-results
**/playwright-report

# Docker files themselves (avoid recursive context)
**/Dockerfile
docker-compose*.yml
