{
  "name": "@wide-label/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/index.test.ts lib/**/*.test.ts components/**/*.test.ts",
    "test:unit": "tsx --test src/index.test.ts lib/**/*.test.ts components/**/*.test.ts",
    "test:integration": "tsx --test lib/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "tsx --test src/index.test.ts lib/**/*.test.ts components/**/*.test.ts && playwright test"
  },
  "dependencies": {
    "@wide-label/config": "workspace:*",
    "@wide-label/types": "workspace:*",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
