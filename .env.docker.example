# WIDE LABEL — Docker environment file template
# Copy to .env.docker and set real values before running docker compose.
# .env.docker is git-ignored. Never commit real secrets.
#
# Usage:
#   cp .env.docker.example .env.docker
#   # Fill in real values
#   docker compose -f infra/docker-compose.yml up -d

# ── Medusa auth (REQUIRED — no fallback in production) ───────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-random-characters
COOKIE_SECRET=replace-with-32-plus-random-characters

# ── CORS (adjust to your domain) ─────────────────────────────────────────────
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
SHOPOWNER_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:7001,http://localhost:9000,http://localhost:3000

# ── Cart & Reservation ───────────────────────────────────────────────────────
CART_COOKIE_NAME=wl_cart_id
CART_HOLD_MINUTES=15
PAYMENT_PENDING_EXTRA_MINUTES=10
RESERVATION_SWEEPER_BATCH=500

# ── MinIO / S3 (container-internal endpoint set in docker-compose) ────────────
MINIO_ROOT_USER=wide_label_minio_admin
MINIO_ROOT_PASSWORD=wide_label_minio_secret_key_123
S3_REGION=us-east-1
S3_BUCKET=wide-label-media
S3_ACCESS_KEY=wide_label_minio_admin
S3_SECRET_KEY=wide_label_minio_secret_key_123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9002/wide-label-media

# ── YooKassa ─────────────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=replace-me
YOOKASSA_SECRET_KEY=replace-me
YOOKASSA_WEBHOOK_SECRET=replace-me
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/success

# ── CDEK ─────────────────────────────────────────────────────────────────────
CDEK_CLIENT_ID=replace-me
CDEK_CLIENT_SECRET=replace-me
CDEK_API_URL=https://api.edu.cdek.ru/v2
CDEK_WIDGET_URL=https://widget.cdek.ru
CDEK_WEBHOOK_SECRET=replace-me
CDEK_FROM_CITY_CODE=44
CDEK_FROM_POSTAL_CODE=000000
CDEK_FROM_ADDRESS=Replace before production
CDEK_PACKAGE_WEIGHT_GRAMS=1000
CDEK_PACKAGE_LENGTH_CM=30
CDEK_PACKAGE_WIDTH_CM=25
CDEK_PACKAGE_HEIGHT_CM=10

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=hello@wide-label.example
EMAIL_API_KEY=replace-me
EMAIL_REPLY_TO=hello@wide-label.example

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=wide_label_bot

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ── Storefront public vars (baked at build time via docker-compose build args) ─
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_CDEK_WIDGET_URL=https://widget.cdek.ru
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_DEFAULT_LOCALE=ru
